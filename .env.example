# URL of the Express backend (server-side only). Requests to /api/v1/* are proxied here.
BACKEND_URL=http://localhost:8000

# Public URL of this frontend (used for SEO metadata and sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: call the backend directly from the browser instead of through the proxy.
# Leave empty in most cases - cross-site cookies are blocked by many browsers.
NEXT_PUBLIC_API_URL=

# Payments. Leave false to make every course free (must match PAYMENTS_ENABLED on the server).
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Google sign-in: OAuth "Web application" client ID from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
